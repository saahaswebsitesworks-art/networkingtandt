# Copy this file to .env.local and fill in your values

# Business contact (used for tel:, WhatsApp, and email links)
NEXT_PUBLIC_BUSINESS_NAME="Networking Tours & Travels"
NEXT_PUBLIC_BUSINESS_PHONE="+917975630631"
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY="079756 30631"
NEXT_PUBLIC_WHATSAPP_NUMBER="917975630631"
NEXT_PUBLIC_BUSINESS_EMAIL="networkingtoursandtravels@gmail.com"

# Admin panel password (change this!)
ADMIN_PASSWORD="admin123"

# ---------------------------------------------------------------------------
# Neon (serverless Postgres) — where bookings and rates are stored.
# This is what makes data actually persist when deployed on Vercel or any
# serverless host. If it's left blank the site still runs, but bookings are
# only kept in memory (lost on restart) and rates use the local JSON file.
#
# To set up: neon.tech -> create a project -> copy the "Connection string"
# (use the pooled one, host contains "-pooler"). It looks like:
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Tables are created automatically the first time the app runs.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Razorpay — online payments for the "25% advance" and "100% now" options.
# The "Pay after ride" option needs no keys. Get these from the Razorpay
# Dashboard -> Settings -> API Keys (use test keys first: rzp_test_...).
# KEY_ID is safe to expose to the browser; KEY_SECRET must stay server-only.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Distance: still 100% keyless. Driving distance is computed from
# OpenStreetMap's free public routers (Valhalla + OSRM) on the server, and the
# booking page shows the route on a keyless Google Maps embed (no API key or
# billing needed). Optional: a small buffer added to the raw distance so per-km
# fares don't under-count vs Google. Default 0.10 (=+10%), range 0–1.
# ---------------------------------------------------------------------------
DISTANCE_BUFFER=0.10

# Optional: SMTP settings so the server can auto-email the owner on every
# booking. If left blank, email sending is simply skipped and the site still
# works fine (booking is stored + WhatsApp/Call buttons still work).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO="networkingtoursandtravels@gmail.com"
